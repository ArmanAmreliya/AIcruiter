{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "GEMEINI_API_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "NEXT_SUPABASE_URL",
        "NEXT_SUPABASE_ANON_KEY",
        "NEXT_AI_API_KEY",
        "NEXT_REPORT_API_KEY",
        "NEXT_DEEPGRAM_API_KEY",
        "DAILY_API_KEY",
        "DAILY_ROOM_URL",
        "NEXT_PUBLIC_API_URL",
        "PIPECAT_BOT_URL"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:unit": {
      "cache": false
    }
  }
}
